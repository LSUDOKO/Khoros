# Khoros — environment
#
# Copy to .env.local and fill in. Nothing here is required to run the app
# locally: without a database the arena renders a designed "unavailable" state
# rather than placeholder rows.

# --- Chain ------------------------------------------------------------------

# Read-only. Agent registry and reputation data come from BSC mainnet.
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com

# All execution happens here — sessions, jobs, agent transactions.
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# --- Agent registry ---------------------------------------------------------

# 8004scan Pro API key. Apply via the Pro-Tier Upgrade Form; it is not instant.
# Without it the indexer falls back to direct ERC-8004 registry reads.
SCAN8004_API_KEY=
SCAN8004_BASE_URL=https://8004scan.io/api

# --- Persistence ------------------------------------------------------------

# Postgres. Neon and Supabase both have free tiers.
DATABASE_URL=

# Optional — caches ranked lists per category.
REDIS_URL=

# --- PACE verifier ----------------------------------------------------------

# The verifier key is the trust anchor for every agent action.
#
# In production this MUST be a KMS reference. The service refuses to start with
# a raw key under NODE_ENV=production, and refuses to fall back to one when a
# KMS id is configured — a silent downgrade of the trust anchor is exactly the
# failure that check exists to prevent.
VERIFIER_KMS_KEY_ID=

# Local development only. Never commit a real value.
VERIFIER_SIGNER_KEY=

# Where agent runtimes reach the verifier. Must NOT be reachable from the web app.
VERIFIER_URL=http://localhost:8080

# Deployed PolicyAttestedExecutor on chain 97.
EXECUTOR_ADDRESS=

# --- Gas sponsorship --------------------------------------------------------

MEGAFUEL_PAYMASTER_URL=

# --- Benchmark --------------------------------------------------------------

# Throwaway testnet key for the Altana spike only. Holds nothing of value.
# See TESTNET_SETUP.md.
SPIKE_ADMIN_KEY=
